{
  "datasets": [
    {
      "name": "796c2a7a",
      "displayName": "dim_calendar",
      "config": {
        "version": "1.1",
        "source": "happy_family_homestay.gold.dim_calendar",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "836cd43a",
      "displayName": "fact_booking",
      "config": {
        "version": "1.1",
        "source": "happy_family_homestay.gold.fact_booking",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "revenue_total",
            "expr": "SUM(source.total_revenue)",
            "displayName": "Total Pendapatan",
            "format": {
              "type": "currency",
              "currencyCode": "IDR",
              "abbreviation": "compact"
            }
          },
          {
            "name": "stay_nights_total",
            "expr": "SUM(source.stay_nights)",
            "displayName": "Total Malam Menginap"
          },
          {
            "displayName": "ALOS (Rata-rata Lama Menginap)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "alos",
            "expr": "SUM(source.stay_nights) / NULLIF(COUNT(*), 0)",
            "comment": "Rata-rata malam menginap per booking"
          }
        ]
      }
    },
    {
      "name": "db88a68a",
      "displayName": "fact_daily_stay",
      "config": {
        "version": "1.1",
        "source": "SELECT\n    s.daily_stay_id,\n    s.booking_id,\n    s.stay_date,\n    s.guest_count,\n    s.total_rooms_booked,\n    s.daily_revenue,\n    COALESCE(b.visiting_purpose, 'Unknown') AS visiting_purpose\nFROM happy_family_homestay.gold.fact_daily_stay AS s\nLEFT JOIN happy_family_homestay.gold.fact_booking AS b\n    ON s.booking_id = b.booking_id",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "kpi_daily_homestay",
      "displayName": "KPI Harian Homestay",
      "config": {
        "version": "1.1",
        "source": "SELECT\n    c.date AS stay_date,\n    c.day_of_week,\n    c.is_weekend,\n    c.year_month,\n    p.visiting_purpose,\n    COALESCE(f.rooms_booked, 0) AS rooms_booked,\n    COALESCE(f.daily_revenue, 0) AS daily_revenue\nFROM happy_family_homestay.gold.dim_calendar AS c\nLEFT JOIN (\n    SELECT DISTINCT COALESCE(visiting_purpose, 'Unknown') AS visiting_purpose\n    FROM happy_family_homestay.gold.fact_booking\n) AS p\n    ON TRUE\nLEFT JOIN (\n    SELECT\n        s.stay_date,\n        COALESCE(b.visiting_purpose, 'Unknown') AS visiting_purpose,\n        SUM(s.total_rooms_booked) AS rooms_booked,\n        SUM(s.daily_revenue)      AS daily_revenue\n    FROM happy_family_homestay.gold.fact_daily_stay AS s\n    LEFT JOIN happy_family_homestay.gold.fact_booking AS b\n        ON s.booking_id = b.booking_id\n    GROUP BY s.stay_date, COALESCE(b.visiting_purpose, 'Unknown')\n) AS f\n    ON c.date = f.stay_date AND p.visiting_purpose = f.visiting_purpose",
        "dimensions": [
          {
            "name": "stay_date",
            "expr": "source.stay_date",
            "comment": "Tanggal menginap; satu baris per tanggal kalender, termasuk hari tanpa booking"
          },
          {
            "name": "year_month",
            "expr": "source.year_month"
          },
          {
            "name": "day_of_week",
            "expr": "source.day_of_week"
          },
          {
            "name": "day_of_week_ordered",
            "expr": "CASE source.day_of_week WHEN 'Monday' THEN '1. Senin' WHEN 'Tuesday' THEN '2. Selasa' WHEN 'Wednesday' THEN '3. Rabu' WHEN 'Thursday' THEN '4. Kamis' WHEN 'Friday' THEN '5. Jumat' WHEN 'Saturday' THEN '6. Sabtu' WHEN 'Sunday' THEN '7. Minggu' END",
            "comment": "Hari dalam seminggu, diurutkan Senin sampai Minggu"
          },
          {
            "name": "is_weekend",
            "expr": "source.is_weekend"
          },
          {
            "name": "visiting_purpose",
            "expr": "source.visiting_purpose",
            "comment": "Tujuan kunjungan tamu; memungkinkan filter KPI harian per tujuan kunjungan"
          }
        ],
        "measures": [
          {
            "name": "rooms_sold",
            "expr": "SUM(source.rooms_booked)",
            "displayName": "Kamar Terjual"
          },
          {
            "name": "room_revenue",
            "expr": "SUM(source.daily_revenue)",
            "displayName": "Pendapatan Kamar",
            "format": {
              "type": "currency",
              "currencyCode": "IDR",
              "abbreviation": "compact"
            }
          },
          {
            "displayName": "ADR (Average Daily Rate)",
            "format": {
              "type": "currency",
              "currencyCode": "IDR",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "adr",
            "expr": "SUM(source.daily_revenue) / NULLIF(SUM(source.rooms_booked), 0)",
            "comment": "Pendapatan kamar dibagi jumlah kamar terjual (room equivalents)"
          },
          {
            "displayName": "Occupancy",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "occupancy",
            "expr": "SUM(source.rooms_booked) / NULLIF(7 * COUNT(DISTINCT source.stay_date), 0)",
            "comment": "Room-nights terjual dibagi kapasitas 7 room equivalents per hari"
          },
          {
            "displayName": "RevPAR",
            "format": {
              "type": "currency",
              "currencyCode": "IDR",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "revpar",
            "expr": "SUM(source.daily_revenue) / NULLIF(7 * COUNT(DISTINCT source.stay_date), 0)",
            "comment": "Pendapatan kamar dibagi room-nights tersedia (kapasitas 7)"
          },
          {
            "name": "available_room_nights",
            "expr": "7 * COUNT(DISTINCT source.stay_date)",
            "displayName": "Room-Nights Tersedia"
          }
        ]
      }
    }
  ],
